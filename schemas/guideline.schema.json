{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VectOrEditOr Guideline / Profile Schema (guideline_*.json)",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "message", "severity"],
        "properties": {
          "id": { "type": "string" },
          "pattern": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "suggest": { "type": "string" }
        }
      }
    }
  }
}
